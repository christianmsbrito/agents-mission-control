# Copy to .env and edit. Loaded by Bun automatically (bun run …).
# Requires Bun on every machine. Reporter runs on macOS/Linux only (uses ps/lsof);
# focus + prompt-from-card are macOS-only. See README "Requirements & platform support".

# --- shared ---
# Auth secret. Reporter and server MUST match. Change for any non-local use.
MC_TOKEN=dev-token

# --- server ---
MC_PORT=7777
# Drop a host from the board after this many ms of silence.
MC_STALE_MS=10000

# --- reporter ---
# Central hub address. For multi-machine, point at the server's reachable
# (e.g. Tailscale) host: wss://hub.your-tailnet.ts.net:7777/ws/report
MC_SERVER_URL=ws://localhost:7777/ws/report
# Friendly host name shown in the UI (defaults to the machine hostname).
MC_HOST_LABEL=my-mac
# Process scan cadence in ms.
MC_INTERVAL_MS=3000

# --- LLM session recaps (Haiku) ---
# Set to enable one-line recaps per session. Without it, falls back to a
# heuristic summary.
ANTHROPIC_API_KEY=
# 0 to disable recaps even when ANTHROPIC_API_KEY is set.
MC_SUMMARIES=1
MC_SUMMARY_MODEL=claude-haiku-4-5
# Min gap before re-summarizing the same session (cost/latency control).
MC_SUMMARY_INTERVAL_MS=60000
